# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SECRET="your_jwt_secret_here"
IMAGEKIT_AUTH=Basic your_imagekit_base64_auth_here

# ─── Database – Development ───────────────────────────────────────────────────
DB_DEV_USERNAME=postgres
DB_DEV_PASSWORD=your_dev_password
DB_DEV_NAME=yessles_db
DB_DEV_HOST=localhost
DB_DEV_PORT=5432

# ─── Database – Test ──────────────────────────────────────────────────────────
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=
DB_TEST_NAME=yessles_db_test
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5432

# ─── Database – Production ────────────────────────────────────────────────────
DB_PROD_USERNAME=your_prod_username
DB_PROD_PASSWORD=your_prod_password
DB_PROD_NAME=your_prod_db_name
DB_PROD_HOST=localhost
DB_PROD_PORT=5432
